# Vercel → Settings → Environment Variables; never prefix secrets with VITE_ or NEXT_PUBLIC_.
PUBLIC_ORIGIN=https://your-project.vercel.app
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key
SUPABASE_STORAGE_BUCKET=autojuben-media
# Vite frontend needs ONLY public Supabase credentials for direct signed uploads.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
APP_VERSION=0.6.0
MAX_UPLOAD_MB=45
MAX_ACTIVE_JOBS_PER_ORG=3
# openssl rand -base64 32 (32 random bytes encoded as base64)
ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
# openssl rand -hex 32; used by Supabase Cron → Vercel worker endpoint
CRON_SECRET=replace-with-random-long-token
VIDEO_API_BASE_URL=http://113.207.49.151:8045
VIDEO_API_LICENSE_KEY=
MOCK_VIDEO_PROVIDER=true
# Never send the video API license over HTTP unless you understand the plaintext risk.
ALLOW_INSECURE_VIDEO_HTTP=false
PLATFORM_ADMIN_EMAILS=your-verified-admin@example.com
# Optional: configure the following in the administrator UI instead.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
# Optional deployment webhook, not required for normal Vercel Git-based deployments.
DEPLOY_WEBHOOK_URL=
DEPLOY_WEBHOOK_SECRET=
