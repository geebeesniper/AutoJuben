{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:web",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/handler.ts": {
      "maxDuration": 60
    },
    "api/cron.ts": {
      "maxDuration": 60
    },
    "api/stripe.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/healthz",
      "destination": "/api/handler?target=health"
    },
    {
      "source": "/graphql",
      "destination": "/api/handler?target=graphql"
    },
    {
      "source": "/api/json",
      "destination": "/api/handler?target=json"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/handler?target=rest&path=:path*"
    },
    {
      "source": "/auth/:action",
      "destination": "/api/handler?target=auth&action=:action"
    },
    {
      "source": "/api/uploads",
      "destination": "/api/handler?target=uploads"
    },
    {
      "source": "/api/assets/:id",
      "destination": "/api/handler?target=asset&id=:id"
    },
    {
      "source": "/api/jobs/:id/video",
      "destination": "/api/handler?target=video&id=:id"
    },
    {
      "source": "/api/launcher/diagnostics",
      "destination": "/api/handler?target=diagnostics"
    },
    {
      "source": "/api/launcher/backups/:id/manifest",
      "destination": "/api/handler?target=manifest&id=:id"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
