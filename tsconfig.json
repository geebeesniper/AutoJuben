{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "api/**/*.ts",
    "apps/api/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "apps/web/dist",
    "apps/api/dist"
  ]
}
